# Database Configuration (MySQL 8.0)
MYSQL_DATABASE=smart_police_db
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# JWT Security (Zero-Trust 256-bit Secret)
JWT_SECRET=9a3f2b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Rate Limiting (Bucket4j)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SOS_PER_MINUTE=5
RATE_LIMIT_PUBLIC_PER_MINUTE=30

# Python Intelligence Service
PYTHON_SERVICE_HOST=localhost
PYTHON_SERVICE_PORT=8000

# OpenRouter LLM API (Phase 2)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Digital Evidence Object Storage (Phase 3 MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=smart-police-evidence
